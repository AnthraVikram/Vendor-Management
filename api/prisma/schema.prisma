generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  ADMINISTRATOR
  OFFICE_TEAM
  ACCOUNTANT
}

enum Availability {
  AVAILABLE
  LIMITED
  UNAVAILABLE
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum NoteType {
  PAST_WORK
  RELIABILITY
  COORDINATION
  GENERAL
}

enum PricingMode {
  NONE
  FIXED
  FILE
}

enum PriceKind {
  CHARGE
  REVERSAL
}

enum TimelineItemType {
  MILESTONE
  ACTIVITY
}

enum TimelineStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

enum ResponsibleKind {
  NONE
  VENDOR
  FIRM_TEAM
}

enum TimelineDateField {
  PLANNED_DATE
  DEADLINE
}

enum ResponsibleChangeCause {
  EDIT
  LINK_REMOVED
}

model StaffUser {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  email        String    @unique
  phone        String?
  role         StaffRole
  passwordHash String    @map("password_hash")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdById  String    @map("created_by") @db.Uuid
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedById  String    @map("updated_by") @db.Uuid

  createdBy StaffUser @relation("StaffCreatedBy", fields: [createdById], references: [id])
  updatedBy StaffUser @relation("StaffUpdatedBy", fields: [updatedById], references: [id])
  staffCreated StaffUser[] @relation("StaffCreatedBy")
  staffUpdated StaffUser[] @relation("StaffUpdatedBy")

  sessions Session[] @relation("SessionOwner")
  sessionsCreated Session[] @relation("SessionCreatedBy")
  sessionsUpdated Session[] @relation("SessionUpdatedBy")
  categoriesCreated Category[] @relation("CategoryCreatedBy")
  categoriesUpdated Category[] @relation("CategoryUpdatedBy")
  vendorsCreated Vendor[] @relation("VendorCreatedBy")
  vendorsUpdated Vendor[] @relation("VendorUpdatedBy")
  vendorCategoriesCreated VendorCategory[] @relation("VendorCategoryCreatedBy")
  vendorCategoriesUpdated VendorCategory[] @relation("VendorCategoryUpdatedBy")
  locationsCreated VendorLocation[] @relation("VendorLocationCreatedBy")
  locationsUpdated VendorLocation[] @relation("VendorLocationUpdatedBy")
  servicesCreated VendorService[] @relation("VendorServiceCreatedBy")
  servicesUpdated VendorService[] @relation("VendorServiceUpdatedBy")
  materialsCreated VendorMaterial[] @relation("VendorMaterialCreatedBy")
  materialsUpdated VendorMaterial[] @relation("VendorMaterialUpdatedBy")
  ratesCreated VendorRate[] @relation("VendorRateCreatedBy")
  ratesUpdated VendorRate[] @relation("VendorRateUpdatedBy")
  notesCreated VendorNote[] @relation("VendorNoteCreatedBy")
  notesUpdated VendorNote[] @relation("VendorNoteUpdatedBy")
  ratingsCreated VendorRating[] @relation("VendorRatingCreatedBy")
  ratingsUpdated VendorRating[] @relation("VendorRatingUpdatedBy")
  projectsCreated Project[] @relation("ProjectCreatedBy")
  projectsUpdated Project[] @relation("ProjectUpdatedBy")
  linksCreated VendorProjectLink[] @relation("LinkCreatedBy")
  linksUpdated VendorProjectLink[] @relation("LinkUpdatedBy")
  schedulesCreated WorkSchedule[] @relation("ScheduleCreatedBy")
  schedulesUpdated WorkSchedule[] @relation("ScheduleUpdatedBy")
  pricesCreated TaskPriceEntry[] @relation("PriceCreatedBy")
  pricesUpdated TaskPriceEntry[] @relation("PriceUpdatedBy")
  filesCreated CostingSheetFile[] @relation("FileCreatedBy")
  filesUpdated CostingSheetFile[] @relation("FileUpdatedBy")
  timelineItemsCreated TimelineItem[] @relation("TimelineItemCreatedBy")
  timelineItemsUpdated TimelineItem[] @relation("TimelineItemUpdatedBy")
  dateChangesCreated TimelineDateChange[] @relation("DateChangeCreatedBy")
  dateChangesUpdated TimelineDateChange[] @relation("DateChangeUpdatedBy")
  responsibleChangesCreated TimelineResponsibleChange[] @relation("ResponsibleChangeCreatedBy")
  responsibleChangesUpdated TimelineResponsibleChange[] @relation("ResponsibleChangeUpdatedBy")
  progressUpdatesCreated TimelineProgressUpdate[] @relation("ProgressUpdateCreatedBy")
  progressUpdatesUpdated TimelineProgressUpdate[] @relation("ProgressUpdateUpdatedBy")
  delaysCreated Delay[] @relation("DelayCreatedBy")
  delaysUpdated Delay[] @relation("DelayUpdatedBy")
  issuesCreated CoordinationIssue[] @relation("IssueCreatedBy")
  issuesUpdated CoordinationIssue[] @relation("IssueUpdatedBy")
  issueVendorsCreated CoordinationIssueVendor[] @relation("IssueVendorCreatedBy")
  issueVendorsUpdated CoordinationIssueVendor[] @relation("IssueVendorUpdatedBy")

  @@map("staff_users")
}

model Session {
  id          String    @id @default(uuid()) @db.Uuid
  staffUserId String    @map("staff_user_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdById String    @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at")
  updatedById String    @map("updated_by") @db.Uuid

  staffUser StaffUser @relation("SessionOwner", fields: [staffUserId], references: [id])
  createdBy StaffUser @relation("SessionCreatedBy", fields: [createdById], references: [id])
  updatedBy StaffUser @relation("SessionUpdatedBy", fields: [updatedById], references: [id])

  @@map("sessions")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  createdAt   DateTime @default(now()) @map("created_at")
  createdById String   @map("created_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String   @map("updated_by") @db.Uuid

  createdBy StaffUser @relation("CategoryCreatedBy", fields: [createdById], references: [id])
  updatedBy StaffUser @relation("CategoryUpdatedBy", fields: [updatedById], references: [id])
  vendors   VendorCategory[]

  @@map("categories")
}

model Vendor {
  id             String        @id @default(uuid()) @db.Uuid
  name           String
  contactPerson  String?       @map("contact_person")
  phone          String
  alternatePhone String?       @map("alternate_phone")
  email          String?
  address        String?
  gstRegistered  Boolean       @map("gst_registered")
  gstin          String?       @unique
  gstLegalName   String?       @map("gst_legal_name")
  teamSize       Int?          @map("team_size")
  availability   Availability?
  manpowerNote   String?       @map("manpower_note")
  archived       Boolean       @default(false)
  createdAt      DateTime      @default(now()) @map("created_at")
  createdById    String        @map("created_by") @db.Uuid
  updatedAt      DateTime      @updatedAt @map("updated_at")
  updatedById    String        @map("updated_by") @db.Uuid

  createdBy  StaffUser @relation("VendorCreatedBy", fields: [createdById], references: [id])
  updatedBy  StaffUser @relation("VendorUpdatedBy", fields: [updatedById], references: [id])
  categories VendorCategory[]
  locations  VendorLocation[]
  services   VendorService[]
  materials  VendorMaterial[]
  rates      VendorRate[]
  notes      VendorNote[]
  ratings    VendorRating[]
  links      VendorProjectLink[]
  schedules  WorkSchedule[]
  responsibleItems      TimelineItem[]
  responsibleChangesOld TimelineResponsibleChange[] @relation("ResponsibleChangeOldVendor")
  responsibleChangesNew TimelineResponsibleChange[] @relation("ResponsibleChangeNewVendor")
  coordinationIssues    CoordinationIssueVendor[]

  @@map("vendors")
}

model VendorCategory {
  id          String   @id @default(uuid()) @db.Uuid
  vendorId    String   @map("vendor_id") @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  createdById String   @map("created_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String   @map("updated_by") @db.Uuid

  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  category  Category @relation(fields: [categoryId], references: [id])
  createdBy StaffUser @relation("VendorCategoryCreatedBy", fields: [createdById], references: [id])
  updatedBy StaffUser @relation("VendorCategoryUpdatedBy", fields: [updatedById], references: [id])

  @@unique([vendorId, categoryId])
  @@map("vendor_categories")
}

model VendorLocation {
  id          String   @id @default(uuid()) @db.Uuid
  vendorId    String   @map("vendor_id") @db.Uuid
  label       String
  createdAt   DateTime @default(now()) @map("created_at")
  createdById String   @map("created_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String   @map("updated_by") @db.Uuid

  vendor    Vendor @relation(fields: [vendorId], references: [id])
  createdBy StaffUser @relation("VendorLocationCreatedBy", fields: [createdById], references: [id])
  updatedBy StaffUser @relation("VendorLocationUpdatedBy", fields: [updatedById], references: [id])

  @@unique([vendorId, label])
  @@map("vendor_locations")
}

model VendorService {
  id          String   @id @default(uuid()) @db.Uuid
  vendorId    String   @map("vendor_id") @db.Uuid
  label       String
  createdAt   DateTime @default(now()) @map("created_at")
  createdById String   @map("created_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String   @map("updated_by") @db.Uuid

  vendor    Vendor @relation(fields: [vendorId], references: [id])
  createdBy StaffUser @relation("VendorServiceCreatedBy", fields: [createdById], references: [id])
  updatedBy StaffUser @relation("VendorServiceUpdatedBy", fields: [updatedById], references: [id])

  @@unique([vendorId, label])
  @@map("vendor_services")
}

model VendorMaterial {
  id          String   @id @default(uuid()) @db.Uuid
  vendorId    String   @map("vendor_id") @db.Uuid
  label       String
  createdAt   DateTime @default(now()) @map("created_at")
  createdById String   @map("created_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String   @map("updated_by") @db.Uuid

  vendor    Vendor @relation(fields: [vendorId], references: [id])
  createdBy StaffUser @relation("VendorMaterialCreatedBy", fields: [createdById], references: [id])
  updatedBy StaffUser @relation("VendorMaterialUpdatedBy", fields: [updatedById], references: [id])

  @@unique([vendorId, label])
  @@map("vendor_materials")
}

model VendorRate {
  id          String   @id @default(uuid()) @db.Uuid
  vendorId    String   @map("vendor_id") @db.Uuid
  label       String
  amount      Decimal  @db.Decimal(15, 2)
  unit        String
  createdAt   DateTime @default(now()) @map("created_at")
  createdById String   @map("created_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String   @map("updated_by") @db.Uuid

  vendor    Vendor @relation(fields: [vendorId], references: [id])
  createdBy StaffUser @relation("VendorRateCreatedBy", fields: [createdById], references: [id])
  updatedBy StaffUser @relation("VendorRateUpdatedBy", fields: [updatedById], references: [id])

  @@map("vendor_rates")
}

model VendorNote {
  id          String   @id @default(uuid()) @db.Uuid
  vendorId    String   @map("vendor_id") @db.Uuid
  noteType    NoteType @map("note_type")
  body        String
  createdAt   DateTime @default(now()) @map("created_at")
  createdById String   @map("created_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String   @map("updated_by") @db.Uuid

  vendor    Vendor @relation(fields: [vendorId], references: [id])
  createdBy StaffUser @relation("VendorNoteCreatedBy", fields: [createdById], references: [id])
  updatedBy StaffUser @relation("VendorNoteUpdatedBy", fields: [updatedById], references: [id])

  @@map("vendor_notes")
}

model VendorRating {
  id          String   @id @default(uuid()) @db.Uuid
  vendorId    String   @map("vendor_id") @db.Uuid
  score       Int
  comment     String?
  createdAt   DateTime @default(now()) @map("created_at")
  createdById String   @map("created_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String   @map("updated_by") @db.Uuid

  vendor    Vendor @relation(fields: [vendorId], references: [id])
  createdBy StaffUser @relation("VendorRatingCreatedBy", fields: [createdById], references: [id])
  updatedBy StaffUser @relation("VendorRatingUpdatedBy", fields: [updatedById], references: [id])

  @@map("vendor_ratings")
}

model Project {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  clientName   String?       @map("client_name")
  siteLocation String?       @map("site_location")
  description  String?
  status       ProjectStatus
  archived     Boolean       @default(false)
  createdAt    DateTime      @default(now()) @map("created_at")
  createdById  String        @map("created_by") @db.Uuid
  updatedAt    DateTime      @updatedAt @map("updated_at")
  updatedById  String        @map("updated_by") @db.Uuid

  createdBy StaffUser @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  updatedBy StaffUser @relation("ProjectUpdatedBy", fields: [updatedById], references: [id])
  links     VendorProjectLink[]
  schedules WorkSchedule[]
  timelineItems      TimelineItem[]
  delays             Delay[]
  coordinationIssues CoordinationIssue[]

  @@map("projects")
}

model VendorProjectLink {
  id            String   @id @default(uuid()) @db.Uuid
  vendorId      String   @map("vendor_id") @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  roleOnProject String?  @map("role_on_project")
  scopeOfWork   String?  @map("scope_of_work")
  note          String?
  createdAt     DateTime @default(now()) @map("created_at")
  createdById   String   @map("created_by") @db.Uuid
  updatedAt     DateTime @updatedAt @map("updated_at")
  updatedById   String   @map("updated_by") @db.Uuid

  vendor    Vendor  @relation(fields: [vendorId], references: [id])
  project   Project @relation(fields: [projectId], references: [id])
  createdBy StaffUser @relation("LinkCreatedBy", fields: [createdById], references: [id])
  updatedBy StaffUser @relation("LinkUpdatedBy", fields: [updatedById], references: [id])

  @@unique([vendorId, projectId])
  @@map("vendor_project_links")
}

model WorkSchedule {
  id               String      @id @default(uuid()) @db.Uuid
  vendorId         String      @map("vendor_id") @db.Uuid
  projectId        String      @map("project_id") @db.Uuid
  task             String
  workDate         DateTime    @map("work_date") @db.Date
  startTime        String      @map("start_time")
  endTime          String      @map("end_time")
  requiredTeamSize Int         @map("required_team_size")
  pricingMode      PricingMode @default(NONE) @map("pricing_mode")
  archived         Boolean     @default(false)
  createdAt        DateTime    @default(now()) @map("created_at")
  createdById      String      @map("created_by") @db.Uuid
  updatedAt        DateTime    @updatedAt @map("updated_at")
  updatedById      String      @map("updated_by") @db.Uuid

  vendor    Vendor  @relation(fields: [vendorId], references: [id])
  project   Project @relation(fields: [projectId], references: [id])
  createdBy StaffUser @relation("ScheduleCreatedBy", fields: [createdById], references: [id])
  updatedBy StaffUser @relation("ScheduleUpdatedBy", fields: [updatedById], references: [id])
  prices    TaskPriceEntry[]
  files     CostingSheetFile[]

  @@map("work_schedules")
}

model TaskPriceEntry {
  id              String    @id @default(uuid()) @db.Uuid
  scheduleId      String    @map("schedule_id") @db.Uuid
  amount          Decimal   @db.Decimal(15, 2)
  kind            PriceKind
  reversesEntryId String?   @unique @map("reverses_entry_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  createdById     String    @map("created_by") @db.Uuid
  updatedAt       DateTime  @updatedAt @map("updated_at")
  updatedById     String    @map("updated_by") @db.Uuid

  schedule      WorkSchedule    @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  reversesEntry TaskPriceEntry? @relation("PriceReversal", fields: [reversesEntryId], references: [id])
  reversedBy    TaskPriceEntry? @relation("PriceReversal")
  createdBy     StaffUser       @relation("PriceCreatedBy", fields: [createdById], references: [id])
  updatedBy     StaffUser       @relation("PriceUpdatedBy", fields: [updatedById], references: [id])

  @@map("task_price_entries")
}

model CostingSheetFile {
  id               String   @id @default(uuid()) @db.Uuid
  scheduleId       String   @map("schedule_id") @db.Uuid
  storageKey       String   @map("storage_key")
  originalFilename String   @map("original_filename")
  mediaType        String   @map("media_type")
  byteSize         Int      @map("byte_size")
  archived         Boolean  @default(false)
  createdAt        DateTime @default(now()) @map("created_at")
  createdById      String   @map("created_by") @db.Uuid
  updatedAt        DateTime @updatedAt @map("updated_at")
  updatedById      String   @map("updated_by") @db.Uuid

  schedule  WorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  createdBy StaffUser    @relation("FileCreatedBy", fields: [createdById], references: [id])
  updatedBy StaffUser    @relation("FileUpdatedBy", fields: [updatedById], references: [id])

  @@map("costing_sheet_files")
}

model TimelineItem {
  id                  String           @id @default(uuid()) @db.Uuid
  projectId           String           @map("project_id") @db.Uuid
  itemType            TimelineItemType @map("item_type")
  name                String
  description         String?
  plannedDate         DateTime?        @map("planned_date") @db.Date
  deadline            DateTime         @db.Date
  responsibleKind     ResponsibleKind  @default(NONE) @map("responsible_kind")
  responsibleVendorId String?          @map("responsible_vendor_id") @db.Uuid
  archived            Boolean          @default(false)
  createdAt           DateTime         @default(now()) @map("created_at")
  createdById         String           @map("created_by") @db.Uuid
  updatedAt           DateTime         @updatedAt @map("updated_at")
  updatedById         String           @map("updated_by") @db.Uuid

  project            Project                     @relation(fields: [projectId], references: [id])
  responsibleVendor  Vendor?                     @relation(fields: [responsibleVendorId], references: [id])
  createdBy          StaffUser                   @relation("TimelineItemCreatedBy", fields: [createdById], references: [id])
  updatedBy          StaffUser                   @relation("TimelineItemUpdatedBy", fields: [updatedById], references: [id])
  dateChanges        TimelineDateChange[]
  responsibleChanges TimelineResponsibleChange[]
  progressUpdates    TimelineProgressUpdate[]
  delays             Delay[]
  coordinationIssues CoordinationIssue[]

  @@index([projectId, archived, deadline, name])
  @@index([responsibleVendorId])
  @@map("timeline_items")
}

model TimelineDateChange {
  id             String            @id @default(uuid()) @db.Uuid
  timelineItemId String            @map("timeline_item_id") @db.Uuid
  field          TimelineDateField
  oldValue       DateTime?         @map("old_value") @db.Date
  newValue       DateTime?         @map("new_value") @db.Date
  createdAt      DateTime          @default(now()) @map("created_at")
  createdById    String            @map("created_by") @db.Uuid
  updatedAt      DateTime          @updatedAt @map("updated_at")
  updatedById    String            @map("updated_by") @db.Uuid

  timelineItem TimelineItem @relation(fields: [timelineItemId], references: [id])
  createdBy    StaffUser    @relation("DateChangeCreatedBy", fields: [createdById], references: [id])
  updatedBy    StaffUser    @relation("DateChangeUpdatedBy", fields: [updatedById], references: [id])

  @@map("timeline_date_changes")
}

model TimelineResponsibleChange {
  id             String                 @id @default(uuid()) @db.Uuid
  timelineItemId String                 @map("timeline_item_id") @db.Uuid
  oldKind        ResponsibleKind        @map("old_kind")
  oldVendorId    String?                @map("old_vendor_id") @db.Uuid
  newKind        ResponsibleKind        @map("new_kind")
  newVendorId    String?                @map("new_vendor_id") @db.Uuid
  cause          ResponsibleChangeCause
  createdAt      DateTime               @default(now()) @map("created_at")
  createdById    String                 @map("created_by") @db.Uuid
  updatedAt      DateTime               @updatedAt @map("updated_at")
  updatedById    String                 @map("updated_by") @db.Uuid

  timelineItem TimelineItem @relation(fields: [timelineItemId], references: [id])
  oldVendor    Vendor?      @relation("ResponsibleChangeOldVendor", fields: [oldVendorId], references: [id])
  newVendor    Vendor?      @relation("ResponsibleChangeNewVendor", fields: [newVendorId], references: [id])
  createdBy    StaffUser    @relation("ResponsibleChangeCreatedBy", fields: [createdById], references: [id])
  updatedBy    StaffUser    @relation("ResponsibleChangeUpdatedBy", fields: [updatedById], references: [id])

  @@map("timeline_responsible_changes")
}

model TimelineProgressUpdate {
  id             String         @id @default(uuid()) @db.Uuid
  timelineItemId String         @map("timeline_item_id") @db.Uuid
  status         TimelineStatus
  note           String?
  seq            Int            @unique @default(autoincrement())
  createdAt      DateTime       @default(now()) @map("created_at")
  createdById    String         @map("created_by") @db.Uuid
  updatedAt      DateTime       @updatedAt @map("updated_at")
  updatedById    String         @map("updated_by") @db.Uuid

  timelineItem TimelineItem @relation(fields: [timelineItemId], references: [id])
  createdBy    StaffUser    @relation("ProgressUpdateCreatedBy", fields: [createdById], references: [id])
  updatedBy    StaffUser    @relation("ProgressUpdateUpdatedBy", fields: [updatedById], references: [id])

  @@index([timelineItemId, seq])
  @@map("timeline_progress_updates")
}

model Delay {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  timelineItemId String?  @map("timeline_item_id") @db.Uuid
  reason         String
  createdAt      DateTime @default(now()) @map("created_at")
  createdById    String   @map("created_by") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at")
  updatedById    String   @map("updated_by") @db.Uuid

  project      Project       @relation(fields: [projectId], references: [id])
  timelineItem TimelineItem? @relation(fields: [timelineItemId], references: [id])
  createdBy    StaffUser     @relation("DelayCreatedBy", fields: [createdById], references: [id])
  updatedBy    StaffUser     @relation("DelayUpdatedBy", fields: [updatedById], references: [id])

  @@map("delays")
}

model CoordinationIssue {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  timelineItemId String?  @map("timeline_item_id") @db.Uuid
  description    String
  createdAt      DateTime @default(now()) @map("created_at")
  createdById    String   @map("created_by") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at")
  updatedById    String   @map("updated_by") @db.Uuid

  project      Project                   @relation(fields: [projectId], references: [id])
  timelineItem TimelineItem?             @relation(fields: [timelineItemId], references: [id])
  vendors      CoordinationIssueVendor[]
  createdBy    StaffUser                 @relation("IssueCreatedBy", fields: [createdById], references: [id])
  updatedBy    StaffUser                 @relation("IssueUpdatedBy", fields: [updatedById], references: [id])

  @@map("coordination_issues")
}

model CoordinationIssueVendor {
  id                  String   @id @default(uuid()) @db.Uuid
  coordinationIssueId String   @map("coordination_issue_id") @db.Uuid
  vendorId            String   @map("vendor_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")
  createdById         String   @map("created_by") @db.Uuid
  updatedAt           DateTime @updatedAt @map("updated_at")
  updatedById         String   @map("updated_by") @db.Uuid

  coordinationIssue CoordinationIssue @relation(fields: [coordinationIssueId], references: [id])
  vendor            Vendor            @relation(fields: [vendorId], references: [id])
  createdBy         StaffUser         @relation("IssueVendorCreatedBy", fields: [createdById], references: [id])
  updatedBy         StaffUser         @relation("IssueVendorUpdatedBy", fields: [updatedById], references: [id])

  @@unique([coordinationIssueId, vendorId])
  @@map("coordination_issue_vendors")
}
